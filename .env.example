# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/palety_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=local-secret
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=local-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_WINDOW_MS=900000
ADMIN_EMAIL=admin@paletbroker.pl
ADMIN_PASSWORD=admin123
DEMO_USER_EMAIL=user@paletbroker.pl
DEMO_USER_PASSWORD=user123
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_BLOCK_MS=60000

# Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@palety.local

# Carriers
DHL_API_KEY=
DHL_API_URL=https://api.dhl.com
DPD_API_KEY=
DPD_API_URL=
FEDEX_API_KEY=
FEDEX_API_URL=
AMBRO_API_KEY=
AMBRO_API_URL=

# Monitoring
SENTRY_DSN=
